<?xml version="1.0" encoding="utf-8"?>
<robot name="picar2" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="port"    default="/dev/ttyYahboom0"/>
  <xacro:arg name="baud"    default="460800"/>
  <xacro:arg name="use_sim" default="false"/>
  <xacro:arg name="lidar"   default="lds02rr"/>
  <xacro:property name="lidar_model"    value="$(arg lidar)"/>
  <xacro:property name="ld07_tilt_rad"  value="0.2793"/>  <!-- 16° mount angle -->

  <!-- ═══════════════════════════════════════════════════
       ros2_control block — joint names match URDF joints
       so robot_state_publisher gets correct TFs
       ═══════════════════════════════════════════════════ -->
  <ros2_control name="picar2" type="system">
    <hardware>
      <xacro:if value="$(arg use_sim)">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:unless value="$(arg use_sim)">
        <plugin>picar2_control/Picar2Hardware</plugin>
        <param name="port">$(arg port)</param>
        <param name="baud">$(arg baud)</param>
        <!-- Steering LUT: delta_us from servo center (ascending) and steer_rad in ROS convention
             (positive = left turn, so positive deg measurement is negated here).
             Measured 2026-05-22 from wheel-angle photo; refine with odom_cal circle test. -->
        <param name="steer_lut_us">-595 -454 -410 -364 -329 -299 -271 -252 -202 -151 -121 -101 128 154	193	257	308	354	433	464	493	545</param>
        <param name="steer_lut_rad">0.6756 0.5308 0.4578 0.4058 0.3513 0.3176 0.2790 0.2443 0.1994 0.1392 0.1062 0.0668 -0.1276 -0.1646 -0.2049 -0.2829	-0.3129	-0.3681	-0.4680	-0.4844	-0.5078	-0.6109</param>
      </xacro:unless>
    </hardware>

    <!-- Rear drive wheels (velocity-controlled) -->
    <joint name="back_left_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="back_right_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Front steering — single servo drives both; controller commands each
         independently (Ackermann inner/outer angles); write() averages them -->
    <joint name="front_left_steer_joint">
      <command_interface name="position">
        <param name="min">-0.6</param>
        <param name="max">0.6</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="front_right_steer_joint">
      <command_interface name="position">
        <param name="min">-0.6</param>
        <param name="max">0.6</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- Front wheels — passive (no encoder); position held at 0 for TF -->
    <joint name="front_left_wheel_joint">
      <state_interface name="position"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <state_interface name="position"/>
    </joint>
  </ros2_control>

  <!-- Gazebo: gz_ros2_control plugin (sim only) -->
  <xacro:if value="$(arg use_sim)">
    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find picar2_bringup)/config/controllers.yaml</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- ═══════════════════════════════════════════════════
       Links
       ═══════════════════════════════════════════════════ -->
  <link name="base_footprint"/>

  <link name="imu_link"/>

  <link name="base_link">
    <inertial>
      <origin xyz="-0.014025 -0.00011707 0.082168" rpy="0 0 0"/>
      <mass value="0.52447"/>
      <inertia ixx="0.00066245" ixy="-3.1852E-08" ixz="-4.6503E-05"
               iyy="0.0012486"  iyz="-3.356E-08"
               izz="0.0018052"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://picar2_description/meshes/base_link.STL"/></geometry>
      <material name=""><color rgba="0 0.62745 0.23529 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.24 0.17 0.08"/></geometry>
    </collision>
  </link>

  <link name="back_right_link">
    <inertial>
      <origin xyz="3.8959E-08 0.0015615 -6.3774E-08" rpy="0 0 0"/>
      <mass value="0.060236"/>
      <inertia ixx="2.5326E-05" ixy="-2.701E-10"  ixz="3.3546E-09"
               iyy="4.4342E-05" iyz="-2.9324E-10"
               izz="2.531E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://picar2_description/meshes/back_right_link.STL"/></geometry>
      <material name=""><color rgba="0.79216 0.81961 0.93333 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.033" length="0.025"/></geometry>
    </collision>
  </link>

  <link name="back_left_link">
    <inertial>
      <origin xyz="-6.87E-08 -0.0015615 3.003E-08" rpy="0 0 0"/>
      <mass value="0.060236"/>
      <inertia ixx="2.531E-05"  ixy="-3.651E-11"  ixz="1.156E-09"
               iyy="4.4343E-05" iyz="-7.02E-11"
               izz="2.5328E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://picar2_description/meshes/back_right_link.STL"/></geometry>
      <material name=""><color rgba="0.79216 0.81961 0.93333 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.033" length="0.025"/></geometry>
    </collision>
  </link>

  <link name="front_left_steer">
    <inertial>
      <origin xyz="-0.0044676 0.0031203 -0.014101" rpy="0 0 0"/>
      <mass value="0.002176"/>
      <inertia ixx="1.4001E-07" ixy="-7.8357E-08" ixz="1.1741E-12"
               iyy="2.7801E-07" iyz="7.8069E-12"
               izz="2.909E-07"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://picar2_description/meshes/front_left_steer.STL"/></geometry>
      <material name=""><color rgba="0.082353 0.56078 0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.03"/></geometry>
    </collision>
  </link>

  <link name="front_left_wheel">
    <inertial>
      <origin xyz="-6.1417E-08 -0.0048115 4.113E-08" rpy="0 0 0"/>
      <mass value="0.060236"/>
      <inertia ixx="2.531E-05"  ixy="2.9987E-10" ixz="3.7781E-09"
               iyy="4.4342E-05" iyz="2.6181E-10"
               izz="2.5326E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://picar2_description/meshes/back_right_link.STL"/></geometry>
      <material name=""><color rgba="0.79216 0.81961 0.93333 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.033" length="0.025"/></geometry>
    </collision>
  </link>

  <link name="front_right_steer">
    <inertial>
      <origin xyz="-0.0045387 -0.0030159 -0.012099" rpy="0 0 0"/>
      <mass value="0.002176"/>
      <inertia ixx="1.4372E-07" ixy="8.1469E-08"  ixz="-1.0492E-12"
               iyy="2.7431E-07" iyz="7.8675E-12"
               izz="2.909E-07"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://picar2_description/meshes/front_left_steer.STL"/></geometry>
      <material name=""><color rgba="0.082353 0.56078 0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.03"/></geometry>
    </collision>
  </link>

  <link name="front_right_wheel">
    <inertial>
      <origin xyz="5.5753E-08 0.0015615 -5.0453E-08" rpy="0 0 0"/>
      <mass value="0.060236"/>
      <inertia ixx="2.5325E-05" ixy="5.201E-11"  ixz="7.1484E-09"
               iyy="4.4343E-05" iyz="6.0924E-11"
               izz="2.5314E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://picar2_description/meshes/back_right_link.STL"/></geometry>
      <material name=""><color rgba="0.79216 0.81961 0.93333 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.033" length="0.025"/></geometry>
    </collision>
  </link>


  <link name="laser_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <xacro:if value="${lidar_model == 'ld19'}">
      <visual>
        <origin xyz="0 0 -0.027" rpy="0 0 -1.5708"/>
        <geometry><mesh filename="package://picar2_description/meshes/ld19.STL" scale="0.001 0.001 0.001"/></geometry>
        <material name=""><color rgba="0.2 0.2 0.2 1"/></material>
      </visual>
    </xacro:if>
    <xacro:unless value="${lidar_model == 'ld19'}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://picar2_description/meshes/laser_link.STL"/></geometry>
        <material name=""><color rgba="1 1 1 1"/></material>
      </visual>
    </xacro:unless>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.07 0.07 0.05"/></geometry>
    </collision>
  </link>

  <!-- LD07 structured-light depth sensor — front centre, fixed mount -->
  <link name="ld07_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 -${ld07_tilt_rad} 0"/>
      <geometry>
        <mesh filename="package://picar2_description/meshes/ld07_ros_model.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name=""><color rgba="0.15 0.15 0.15 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.015 0 0" rpy="0 0 0"/>
      <geometry><box size="0.03 0.03 0.015"/></geometry>
    </collision>
  </link>

  <!-- ═══════════════════════════════════════════════════
       Joints
       ═══════════════════════════════════════════════════ -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0.0 0.0 0.0215" rpy="0 0 0"/>
  </joint>

  <joint name="base_imu" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="-0.05 0.0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- Rear wheels (continuous — drive wheels) -->
  <joint name="back_right_joint" type="continuous">
    <origin xyz="-0.11607 -0.08425 0.0125" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="back_right_link"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <joint name="back_left_joint" type="continuous">
    <origin xyz="-0.11607 0.08425 0.0125" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="back_left_link"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <!-- Front steering knuckles (revolute — single servo via linkage) -->
  <joint name="front_left_steer_joint" type="revolute">
    <origin xyz="0.11922 0.065 0.0262" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="front_left_steer"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="10" velocity="1"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <joint name="front_right_steer_joint" type="revolute">
    <origin xyz="0.11922 -0.065 0.0242" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="front_right_steer"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="10" velocity="1"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <!-- Front wheels (passive — follow steer knuckle) -->
  <joint name="front_left_wheel_joint" type="continuous">
    <origin xyz="0.00022897 0.0228 -0.0141" rpy="0 0 -0.010042"/>
    <parent link="front_left_steer"/>
    <child  link="front_left_wheel"/>
    <axis xyz="0 -1 0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <joint name="front_right_wheel_joint" type="continuous">
    <origin xyz="-0.00025662 -0.019549 -0.0121" rpy="0 0 -0.013126"/>
    <parent link="front_right_steer"/>
    <child  link="front_right_wheel"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <!-- Sensors (fixed) -->
  <joint name="laser_joint" type="fixed">
    <origin xyz="0.012548 0 0.127" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="laser_link"/>
  </joint>

  <joint name="ld07_joint" type="fixed">
    <origin xyz="0.172 0 0.034" rpy="0 ${ld07_tilt_rad} 0"/>
    <parent link="base_link"/>
    <child  link="ld07_link"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════
       Gazebo properties (sim only)
       ═══════════════════════════════════════════════════ -->

  <!-- Drive wheel friction -->
  <gazebo reference="back_left_link">
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <kp>1e6</kp><kd>1.0</kd>
  </gazebo>
  <gazebo reference="back_right_link">
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <kp>1e6</kp><kd>1.0</kd>
  </gazebo>
  <!-- Front wheels low friction (steered, not driven) -->
  <gazebo reference="front_left_wheel">
    <mu1>0.5</mu1><mu2>0.5</mu2>
  </gazebo>
  <gazebo reference="front_right_wheel">
    <mu1>0.5</mu1><mu2>0.5</mu2>
  </gazebo>

  <!-- IMU sensor -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <topic>/model/picar2/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- Magnetometer — co-located with IMU, simulates Earth field via WMM -->
  <gazebo reference="imu_link">
    <sensor name="magnetometer" type="magnetometer">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <topic>/model/picar2/mag</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <magnetometer>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0001</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0001</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0001</stddev></noise></z>
      </magnetometer>
    </sensor>
  </gazebo>

  <!-- LD07 structured-light depth sensor (90° FOV, 5–170 mm) -->
  <gazebo reference="ld07_link">
    <sensor name="ld07" type="gpu_lidar">
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <topic>/model/picar2/ld07_scan</topic>
      <gz_frame_id>ld07_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>160</samples>
            <resolution>1</resolution>
            <min_angle>-0.7330</min_angle>
            <max_angle>0.7854</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.005</min>
          <max>0.400</max>
          <resolution>0.001</resolution>
        </range>
        <noise type="gaussian">
          <mean>0.0</mean>
          <stddev>0.002</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- LiDAR sensor -->
  <gazebo reference="laser_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <topic>/model/picar2/scan</topic>
      <gz_frame_id>laser_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.06</min>
          <max>5.0</max>
          <resolution>0.001</resolution>
        </range>
        <noise type="gaussian">
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>

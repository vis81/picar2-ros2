<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>picar2_control</name>
  <version>0.1.0</version>
  <description>
    ros2_control hardware interface for the PICAR-2 robot.
    Communicates with the Yahboom STM32F103 over USART1 (460800 baud)
    using the custom binary protocol (0xAA framing, CRC-8 Dallas/Maxim).
  </description>
  <maintainer email="valentin.shevchenko@gmail.com">Valentin</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

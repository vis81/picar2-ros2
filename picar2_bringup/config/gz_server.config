<?xml version="1.0" ?>
<!-- Injects required sensor system plugins into any Gazebo world.
     Passed via gz_args --server-config in sim.launch.py.
     Plugins already present in the world file are silently ignored by gz-sim. -->
<server_config>
  <plugins>
    <plugin entity_name="*" entity_type="world"
            filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin entity_name="*" entity_type="world"
            filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin entity_name="*" entity_type="world"
            filename="gz-sim-magnetometer-system"
            name="gz::sim::systems::Magnetometer"/>
  </plugins>
</server_config>

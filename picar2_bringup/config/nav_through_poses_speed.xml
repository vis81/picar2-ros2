<!--
  navigate_through_poses, replanning on speed instead of on a fixed clock.

  Identical to nav_through_poses_ackermann.xml except for the decorator wrapped
  around ComputePathThroughPoses. The clock-based version replans every 3 s
  regardless of what the robot is doing; in a tight space a fresh Reeds-Shepp
  plan computed from inside a pocket tends to open with a leg opposite the one
  just driven, so the robot commits a fraction of a metre and reverses again.

  SpeedController holds 1 Hz at 0.4 m/s and relaxes only as the robot slows, so
  high-speed obstacle response is unchanged while a slow, wedged robot still
  gets a new plan promptly.

  Measured on the navigate_to_pose tree (dead_end_reverse, n=3 per arm): median
  leg length 0.15 m to 0.30-0.94 m, direction reversals 69/77/91 to 5/15/23,
  and 12/12 clean in open driving. Same decorator, same planner, but this tree
  has NOT been measured separately - treat the transfer as expected rather
  than demonstrated.

  RemovePassedGoals trims at 0.4 m, not upstream's 0.7. The web UI's
  flow-through routes count a waypoint passed at the robot's closest
  approach within 0.45 m; if the BT stopped routing through a waypoint
  before the robot got that close, the route would stall on it forever.
  It must not be much smaller either: 0.3 left Nav2 still steering for a
  waypoint (and its exact heading) the UI had already counted as passed,
  and a 0.5 m turning radius turned that into a loop-back at wp0.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath" topic_name="controller_selector"/>
        <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector"/>
        <SpeedController min_rate="0.2" max_rate="1.0"
                         min_speed="0.0" max_speed="0.4">
          <RecoveryNode number_of_retries="1" name="ComputePathThroughPoses">
            <ReactiveSequence>
              <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.4"/>
              <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}"/>
            </ReactiveSequence>
              <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </SpeedController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="{selected_controller}" error_code_id="{follow_path_error_code}"/>
            <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <!-- Recovery is NOT gated on WouldA*RecoveryHelp.

           Upstream gates every route into this subtree on those two
           conditions, and their list is {UNKNOWN, NO_VALID_PATH, TIMEOUT}.
           START_OCCUPIED (305) is not in it, so a robot whose own footprint
           is in a lethal cell gets no recovery at all — the tree fails in
           about 40 ms. Measured on the robot: the planner refused with
           "Start occupied" seven times at one spot, and the car sat against
           a wall it could have reversed away from in one BackUp.

           That exclusion is exactly backwards here. Clearing the costmap is
           the fix for a spurious mark, and BackUp is the fix for a real one.
           The cost of not gating is a few seconds spent recovering from a
           failure recovery cannot help (a bad planner id, say), bounded by
           the retry count above. -->
        <ReactiveFallback name="RecoveryFallback">
          <GoalUpdated/>
          <RoundRobin name="RecoveryActions">
            <!-- Clear, then reverse, in one attempt. BackUp will not move while the
                 footprint is inside an inflated region, which is precisely the state
                 it exists to escape: measured on the robot, three consecutive
                 attempts logged "Collision Ahead - Exiting DriveOnHeading" and the
                 route ended with the car against a wall. Clearing first gives the
                 reversal somewhere to go; the sensors re-mark anything real within
                 a scan. -->
            <Sequence name="ClearThenBackUp">
              <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
              <BackUp backup_dist="0.30" backup_speed="0.15" error_code_id="{backup_error_code}"/>
            </Sequence>
            <Wait wait_duration="5.0"/>
          </RoundRobin>
        </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
